# ============================================================
# PENGEMBANGAN DI KOMPUTER SENDIRI
# ============================================================
# Untuk pemasangan di Vercel, lihat bagian "Deploy" di README.
# Variabel di sana disetel lewat dasbor Vercel, bukan lewat berkas ini
# — berkas .env.local tidak pernah ikut ke repositori.

# Embedded Postgres dikelola oleh scripts/pg.ts dan berjalan di port ini.
# Kalau memakai PostgreSQL sendiri, ubah DATABASE_URL dan set PG_EMBEDDED=0.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/smartflow
PG_EMBEDDED=1
PG_PORT=54329

# --- Chat AI (Tugas 3) -------------------------------------------------
# Koneksi baca-saja untuk chat. Role dibuat oleh db/004_ai_role.sql dan
# oleh pgctl.ts saat mode embedded.
READONLY_DATABASE_URL=

# Kunci OpenRouter. HANYA di server; jangan pernah memakai awalan
# NEXT_PUBLIC_ untuk nilai ini.
OPENROUTER_API_KEY=

# Model OpenRouter yang dipakai. Harus mendukung tool calling.
# Varian :free tidak memotong saldo, tapi punya batas harian.
OPENROUTER_MODEL=

# Model cadangan, dipisah koma. Dipakai OpenRouter lewat parameter
# "models" kalau model utama sedang tidak tersedia atau kena batas.
# Boleh dikosongkan.
OPENROUTER_FALLBACK_MODELS=

# Tingkat penalaran model. Untuk deepseek-v4-flash yang didukung:
# max, high, low. Kosong = low. Isi "default" untuk memakai bawaan model.
OPENROUTER_REASONING_EFFORT=

# Batas waktu satu panggilan ke OpenRouter, dalam milidetik.
# Model penalar butuh lebih lama. Kosong = 120000.
OPENROUTER_TIMEOUT_MS=

# Dikirim sebagai header HTTP-Referer dan X-Title ke OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# ============================================================
# HANYA UNTUK PEMASANGAN DI VERCEL
# ============================================================
# Disetel di dasbor Vercel, bukan di berkas ini.
#
#   DATABASE_URL           connection string pooler dari Supabase
#                          (port 6543, bukan 5432 — lihat README)
#   READONLY_DATABASE_URL  hasil `npm run db:amankan`
#   OPENROUTER_API_KEY     kunci yang sama dengan pengembangan, atau
#                          kunci terpisah supaya pemakaiannya terpisah
#   OPENROUTER_MODEL       sama dengan pengembangan
#
# PG_EMBEDDED dan PG_PORT TIDAK dipakai di Vercel: Postgres tertanam
# hanya untuk komputer sendiri, dan tidak ada kode aplikasi yang
# menyentuhnya.
#
# TERA_SEED_PASSWORD wajib disetel saat menjalankan `npm run db:seed`
# ke database terkelola. Tanpa itu skrip menolak jalan, karena kata
# sandi bawaannya tertulis di repositori yang bisa dibaca publik.
